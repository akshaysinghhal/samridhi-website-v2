# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (your Vercel domain, e.g. https://samridhi-films.vercel.app)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Used by /api/revalidate to refresh pages after publishing
REVALIDATE_SECRET=pick-a-long-random-string

# Client-side copy (same value) — admin UI calls /api/revalidate after saves
NEXT_PUBLIC_REVALIDATE_SECRET=pick-a-long-random-string

# Cloudflare Turnstile (optional — bot protection on lead forms)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend (optional — email notifications for new leads)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender shown on lead emails — must be a domain verified in Resend
LEAD_FROM_EMAIL=Samridhi Website <website@samridhifilms.in>
